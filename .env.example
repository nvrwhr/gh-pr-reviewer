GITHUB_TOKEN=your_github_token_here

# Legacy fallback only when running with -provider=openai
OPENAI_API_KEY=your_openai_api_key_here
ASSISTANT_ID=your_assistant_id_here

# Pi runs inside pi-sandbox:latest. Configure model credentials via one of:
# - env passed to docker through this file, e.g. ANTHROPIC_API_KEY / OPENAI_API_KEY
# - pi /login inside scripts/run-pi-sandbox.sh
# - mounted or baked /root/.pi/agent config in the sandbox image
# ANTHROPIC_API_KEY=your_anthropic_key_here
